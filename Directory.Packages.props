<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Franz Common Stack -->
    <PackageVersion Include="Franz.Common.*" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Business" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Caching" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.DependencyInjection" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.EntityFramework" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.EntityFramework.PostGres" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Errors" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Hosting" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http.Bootstrap" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http.Client" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http.EntityFramework" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mediator" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mediator.Polly" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mediator.OpenTelemetry" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mapping" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Messaging.Bootstrap" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Messaging.EntityFramework" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Messaging.KafKa" Version="2.3.3" />
    <!-- Platform -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <!-- EF tooling: keep the Roslyn graph on one compatible version. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <!-- Third-party -->
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Testcontainers" Version="4.8.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.8.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageVersion Include="Refit" Version="13.0.0" />
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="6.8.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
  </ItemGroup>
</Project>
